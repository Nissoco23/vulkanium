{
  "schemaVersion": 1,
  "id": "vulkanium",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "Vulkanium",
  "description": "Vulkan mesh shader rendering backend for Sodium. A fork of Nvidium by Cortex (MCRcortex) and drouarb.",
  "authors": [
    "Cortex (MCRcortex), original author of Nvidium",
    "drouarb, Vulkan port and maintenance of Nvidium"
  ],
  "contributors": [
    "Nissoco23"
  ],
  "contact": {
    "sources": "https://github.com/Nissoco23/vulkanium",
    "issues": "https://github.com/Nissoco23/vulkanium/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/nvidium/nvidium.png",
  "environment": "client",
  "entrypoints": {
    "sodium:config_api_user": [
      "me.cortex.nvidium.config.ConfigGuiBuilder"
    ]
  },
  "accessWidener" : "nvidium.accesswidener",
  "mixins": [
    "nvidium.mixins.json"
  ],
  "breaks": {
    "nvidium": "*"
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": ["26.2"],
    "sodium": ["0.9.1", "0.9.2"]
  }
}
